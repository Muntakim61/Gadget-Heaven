# Copy this file to .env for local `netlify dev` use, and set the same
# keys in the Netlify dashboard (Site configuration -> Environment variables)
# for production. Never commit the real .env file.

# Server-side only. Get one free at https://aistudio.google.com/apikey
# This must NOT be prefixed with VITE_ — a VITE_ prefix would bundle it
# into the client-side JS and expose it to every visitor.
GEMINI_API_KEY=

# Comma-separated list of origins allowed to call the chat function.
# Set to your real deployed origin(s) in production, e.g.:
# https://gadget-heaven-frontend.netlify.app
ALLOWED_ORIGINS=http://localhost:8888,http://localhost:5173

# Global off switch for the chat feature. Set to "true" in the Netlify
# dashboard to instantly stop all Gemini calls without a redeploy.
CHAT_DISABLED=false
